  <TextView android:id="@+id/refresh" android:layout_width="38dp" android:layout_height="34dp" android:gravity="center" android:background="@drawable/control_bg" android:text="↻" android:textColor="#FFFFFF" android:textSize="21sp"/>
  <TextView android:id="@+id/settings" android:layout_width="38dp" android:layout_height="34dp" android:layout_marginLeft="5dp" android:gravity="center" android:background="@drawable/control_bg" android:text="⚙" android:textColor="#FFFFFF" android:textSize="17sp"/>
