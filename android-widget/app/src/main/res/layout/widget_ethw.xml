  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" android:layout_marginLeft="5dp" android:orientation="vertical" android:background="@drawable/section_bg" android:padding="8dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EST. INCOME" android:textColor="#F18A17" android:textStyle="bold" android:textSize="8sp"/><TextView android:id="@+id/income" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="$-- / day\n$-- / month" android:textColor="#F4F4F4" android:textStyle="bold" android:textSize="10sp"/></LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.35" android:layout_marginLeft="5dp" android:orientation="vertical" android:background="@drawable/section_bg" android:padding="8dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NETWORK" android:textColor="#F18A17" android:textStyle="bold" android:textSize="8sp"/><TextView android:id="@+id/epoch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="EPOCH --\nDAG --\nNEXT --" android:textColor="#F4F4F4" android:textStyle="bold" android:textSize="9sp"/></LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical"><TextView android:id="@+id/updated" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="◷  UPDATED --" android:textColor="#A9ADB2" android:textSize="8sp"/><TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●  K1POOL LINK: OK" android:textColor="#45ED5D" android:textStyle="bold" android:textSize="8sp"/></LinearLayout>
