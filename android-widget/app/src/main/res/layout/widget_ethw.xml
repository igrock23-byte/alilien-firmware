  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.55" android:layout_marginLeft="4dp" android:orientation="vertical" android:background="@drawable/section_bg" android:padding="7dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EST. INCOME" android:textColor="#F28A16" android:textStyle="bold" android:textSize="8sp"/><TextView android:id="@+id/income" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="$-- / day\n$-- / month" android:textColor="#EEEEEE" android:textSize="10sp"/></LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.35" android:layout_marginLeft="4dp" android:orientation="vertical" android:background="@drawable/section_bg" android:padding="7dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NETWORK" android:textColor="#F28A16" android:textStyle="bold" android:textSize="8sp"/><TextView android:id="@+id/epoch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EPOCH --\nDAG --\nNEXT --" android:textColor="#EEEEEE" android:textStyle="bold" android:textSize="9sp"/></LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="4dp"><TextView android:id="@+id/updated" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="UPDATED --" android:textColor="#92979E" android:textSize="8sp"/><TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● ONLINE" android:textColor="#38E657" android:textStyle="bold" android:textSize="8sp"/></LinearLayout>
</LinearLayout>